# ===== OpenRouter API configuration =====
# Your OpenRouter API key. Get one at https://openrouter.ai
OPENROUTER_API_KEY=

# Model to use for the agent loop.
# Defaults to a cheap/free DeepSeek-class reasoning model suited to OpenRouter's
# free tier. Change to any OpenRouter model id (see https://openrouter.ai/models).
# Examples:
#   deepseek/deepseek-chat
#   deepseek/deepseek-r1
#   z-ai/glm-4-flash
#   meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=deepseek/deepseek-chat

# Base URL for the OpenRouter API (leave as-is unless you use a proxy).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Hard upper bound on agent loop iterations before it stops.
# Prevents runaway/expensive loops.
MAX_AGENT_ITERATIONS=30

# Allow higher max output tokens for reasoning-style models on free tier.
MAX_TOKENS=4096